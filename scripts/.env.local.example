# Copy this file to .env.local (same folder) and fill in real values.
# .env.local is gitignored — never commit your real password.

# The live Product Discovery Sessions deployment.
PDS_BASE_URL=https://product-discovery-sessions.vercel.app

# The shared app password — the same one you use to sign in at the URL above.
PDS_APP_PASSWORD=

# Local path to the git repo this script scans for MOON-xxx ticket ids.
MOON_REPO_PATH=C:\Repos\Moon
